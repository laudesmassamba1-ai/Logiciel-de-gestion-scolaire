<property name="styleSheet">
     <string>
    QMainWindow { background-color: #E7EBF3; }
    #sidebar {
        background-color: #F2F5FA;
        border-right: 1px solid #C9D2DF;
        border-top: 1px solid #FFFFFF;
    }
    #lbl_logo {
        color: #20202A; font-size: 13px; font-weight: 800;
        padding: 10px 18px 0px 20px; letter-spacing: 1px;
    }
    #lbl_logo_subtitle {
        color: #A57B0E; font-size: 10px; font-weight: 700;
        padding: 0px 18px 8px 20px; letter-spacing: 0.8px;
    }
    #lbl_section_general, #lbl_section_scolarite,
    #lbl_section_finances, #lbl_section_administration {
        color: #4A5568; font-size: 11px; font-weight: 800;
        letter-spacing: 1.1px; margin: 0 10px;
        padding: 10px 0px 4px 0px;
    }
    #sidebar QPushButton {
        color: #3E4451; text-align: left; padding: 8px 9px;
        border: 1px solid transparent; border-bottom: 2px solid transparent;
        margin: 1px 8px;
        border-radius: 10px; font-size: 12px; font-weight: 600;
        background: transparent;
    }
    #sidebar QPushButton:hover {
        background-color: #FFFFFF; color: #2A2F3A;
        border: 1px solid #D7DEEA; border-bottom: 2px solid #C2CBD8;
    }
    #sidebar QPushButton:pressed { background-color: #ECEFF5; }
    #sidebar QPushButton:checked {
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 #F6C23E, stop:0.6 #DEA821, stop:1 #C28C0C);
        color: #3F2B02; font-weight: 700;
        border: 1px solid #B88E12; border-bottom: 2px solid #9A7007;
    }
    #userBox {
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 #FFFFFF, stop:0.7 #F5F8FC, stop:1 #E9EEF6);
        border: 1px solid #D7DEEA; border-bottom: 2px solid #C2CBD8;
        border-radius: 14px; margin: 8px 10px;
    }
    #lbl_user_name { color: #20202A; font-size: 13px; font-weight: 700; }
    #lbl_user_role { color: #A57B0E; font-size: 11px; font-weight: 700; }
    #btn_logout {
        color: #8A93A6; text-align: left; border: none; font-size: 12px;
        font-weight: 600; padding: 5px 0px; background: transparent; border-radius: 8px;
    }
    #btn_logout:hover { color: #B91C1C; background-color: #FDECEC; }
    </string>
