<property name="styleSheet">
      <string>
    QMainWindow { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EAF2FF, stop:0.45 #F2EEFF, stop:1 #FBF4E6); }
    #sidebar {
        background: rgba(255,255,255,0.72);
        border-right: 1px solid #E7EDF7;
    }
    #lbl_logo {
        color: #1E2430; font-size: 14px; font-weight: 800;
        padding: 12px 18px 0px 20px; letter-spacing: 0.5px;
    }
    #lbl_logo_subtitle {
        color: #C8960C; font-size: 10px; font-weight: 700;
        padding: 2px 18px 10px 20px; letter-spacing: 0.8px;
    }
    #lbl_section_general, #lbl_section_scolarite,
    #lbl_section_finances, #lbl_section_administration, #lbl_section_outils {
        color: #8C96AB; font-size: 11px; font-weight: 700;
        letter-spacing: 1px; margin: 0 10px;
        padding: 12px 0px 4px 0px;
    }
    #sidebar QPushButton {
        color: #465064; text-align: left; padding: 8px 12px;
        border: none;
        margin: 1px 8px;
        border-radius: 12px; font-size: 13px; font-weight: 600;
        background: transparent;
    }
    #sidebar QPushButton:hover {
        background-color: #EDF2FB; color: #1E2430;
    }
    #sidebar QPushButton:pressed { background-color: #E0E8F7; }
    #sidebar QPushButton:checked {
        background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E7ECFE, stop:1 #F0EBFF);
        color: #3A52D8; font-weight: 700;
        border: none;
    }
    #userBox {
        background: rgba(255,255,255,0.9);
        border: 1px solid #4A5568;
        border-radius: 12px; margin: 8px 10px;
    }
    #lbl_user_name { color: #1E2430; font-size: 13px; font-weight: 700; }
    #lbl_user_role { color: #8B5CF6; font-size: 11px; font-weight: 700; }
    #btn_logout {
        color: #8C96AB; text-align: left; border: none; font-size: 12px;
        font-weight: 600; padding: 5px 0px; background: transparent; border-radius: 10px;
    }
    #btn_logout:hover { color: #E5484D; background-color: #FFECEE; }
    </string>
