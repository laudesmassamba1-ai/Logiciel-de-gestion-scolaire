# ============================================================
# Configuration du serveur de synchronisation
# Copier ce fichier vers server/.env puis adapter les valeurs.
#   cp .env.example .env
# Le fichier .env ne doit JAMAIS etre versionne dans git.
# ============================================================

# --- Base de donnees MySQL (obligatoire) ---
GS_DB_HOST=localhost
GS_DB_USER=root
# Mot de passe MySQL : AUCUNE valeur par defaut n'existe plus dans le code.
GS_DB_PASSWORD=
GS_DB_NAME=ecole
# Port MySQL (defaut : 3306). A changer si MySQL tourne en conteneur Docker.
GS_DB_PORT=3306

# --- Securite ---
# Secret de signature des tokens JWT (32 caracteres minimum).
# Generer une valeur : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si vide, un secret aleatoire est genere puis conserve dans server/.jwt_secret.
GS_JWT_SECRET=
# Duree de validite des tokens en secondes (defaut : 8 heures)
GS_TOKEN_EXPIRATION_SECONDES=28800

# --- CORS ---
# Origines autorisees, separees par des virgules. "*" = toutes (sans cookies).
# Exemple multi-postes : http://192.168.1.10:8000,http://192.168.1.11:8000
GS_CORS_ORIGINS=*
